<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_valuation_historical_tree" model="ir.ui.view">
        <field name="name">stock.valuation.historical.tree</field>
        <field name="model">stock.valuation.historical</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="date" />
                <field name="name" optional="hide" />
                <field name="product_id" />
                <field name="product_tmpl_id" optional="hide" />
                <field name="product_categ_id" optional="hide" />
                <field name="valuation_account_id" optional="show" />
                <field name="warehouse_id" />
                <field name="location_id" optional="hide" />
                <field name="quantity" />
                <field name="uom_id" groups="uom.group_uom" optional="hide" />
                <field name="currency_id" column_invisible="1" />
                <field name="cost_price" sum="Cost Price" optional="hide" />
                <field name="value" sum="Total Value" />
                <field name="cost_method" optional="hide" />
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    optional="hide"
                />
            </list>
        </field>
    </record>

    <record id="view_stock_valuation_historical_graph" model="ir.ui.view">
        <field name="name">stock.valuation.historical.graph</field>
        <field name="model">stock.valuation.historical</field>
        <field name="arch" type="xml">
            <graph string="Stock Valuation Analysis" type="line" sample="1">
                <field name="date" interval="month" />
                <field name="value" type="measure" />
                <field name="product_categ_id" type="row" />
            </graph>
        </field>
    </record>

    <record id="view_stock_valuation_historical_pivot" model="ir.ui.view">
        <field name="name">stock.valuation.historical.pivot</field>
        <field name="model">stock.valuation.historical</field>
        <field name="arch" type="xml">
            <pivot string="Stock Valuation Analysis" sample="1">
                <field name="date" type="row" interval="month" />
                <field name="product_categ_id" type="row" />
                <field name="warehouse_id" type="col" />
                <field name="value" type="measure" />
                <field name="quantity" type="measure" />
            </pivot>
        </field>
    </record>

    <record id="view_stock_valuation_historical_search" model="ir.ui.view">
        <field name="name">stock.valuation.historical.search</field>
        <field name="model">stock.valuation.historical</field>
        <field name="arch" type="xml">
            <search string="Stock Valuation historical">
                <field name="name" />
                <filter name="date" string="Date" date="date" />
                <field name="product_id" />
                <field name="product_tmpl_id" />
                <field name="product_categ_id" />
                <field name="warehouse_id" />
                <field name="location_id" />
                <field name="valuation_account_id" />
                <field name="company_id" groups="base.group_multi_company" />
                <filter
                    name="last_valuation"
                    string="Last Valuation"
                    domain="[('date', '>', (context_today() - relativedelta(days=30)).strftime('%Y-%m-%d'))]"
                />
                <group expand="0" string="Group By">
                    <filter
                        string="Product"
                        name="groupby_product"
                        context="{'group_by': 'product_id'}"
                    />
                    <filter
                        string="Product Template"
                        name="groupby_product_template"
                        context="{'group_by': 'product_tmpl_id'}"
                    />
                    <filter
                        string="Product Category"
                        name="groupby_category"
                        context="{'group_by': 'product_categ_id'}"
                    />
                    <filter
                        string="Company"
                        name="groupby_company"
                        context="{'group_by': 'company_id'}"
                        groups="base.group_multi_company"
                    />
                    <filter
                        string="Warehouse"
                        name="groupby_warehouse"
                        context="{'group_by': 'warehouse_id'}"
                    />
                    <filter
                        string="Valuation Account"
                        name="groupby_valuation_account"
                        context="{'group_by': 'valuation_account_id'}"
                    />

                    <filter
                        string="Location"
                        name="groupby_location"
                        context="{'group_by': 'location_id'}"
                    />
                    <filter
                        string="Costing Method"
                        name="groupby_costing"
                        context="{'group_by': 'cost_method'}"
                    />
                    <filter
                        string="Date"
                        name="groupby_date"
                        context="{'group_by': 'date'}"
                    />

                </group>
                <separator />
            </search>
        </field>
    </record>

    <record id="action_stock_valuation_historical" model="ir.actions.act_window">
        <field name="name">Historical Stock Valuation </field>
        <field name="res_model">stock.valuation.historical</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="view_stock_valuation_historical_search" />
        <field name="context">{
            'search_default_last_valuation': 1,
            'search_default_groupby_company': 1,
            'search_default_groupby_warehouse': 1,
            'search_default_groupby_valuation_account': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No historical stock valuation found.
            </p>
            <p>
                Historical stock valuation records are created automatically at the end of each month
                or can be generated manually.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_stock_valuation_historical"
        name="Stock Valuation Historical"
        parent="stock.menu_warehouse_report"
        action="action_stock_valuation_historical"
        sequence="150"
    />

</odoo>
