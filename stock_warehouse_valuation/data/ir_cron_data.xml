<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="ir_cron_monthly_stock_valuation" model="ir.cron">
        <field name="name">Generate Monthly Stock Valuation History</field>
        <field name="model_id" ref="model_stock_valuation_historical" />
        <field name="state">code</field>
        <field name="code">model._run_month_end_valuation()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True" />
    </record>
</odoo>
