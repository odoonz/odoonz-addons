<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record
        id="account_financial_risk.group_account_financial_risk_user"
        model="res.groups"
    >
        <field name="name">User (readonly)</field>
    </record>
    <record id="group_risk_manager" model="res.groups">
        <field name="name">Risk Manager</field>
        <field
            name="category_id"
            ref="account_financial_risk.category_financial_risk"
        />
        <field
            name="implied_ids"
            eval="[(4, ref('account_financial_risk.group_account_financial_risk_manager'))]"
        />
        <field
            name="comment"
        >Can view risk limit and overpass partner risk exceptions</field>
    </record>
    <record id="account.group_account_manager" model="res.groups">
        <field
            name="implied_ids"
            eval="[(4, ref('account_financial_risk_manager.group_risk_manager'))]"
        />
    </record>


</odoo>
