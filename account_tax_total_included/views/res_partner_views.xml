<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_partner_form_inherit_tax_total_included" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.tax.total.included</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form" />
        <field name="arch" type="xml">
            <!-- Add GST Inclusive fields to the Accounting tab -->
            <xpath expr="//notebook//field[@name='autopost_bills']" position="after">
                <field
                    name="force_tax_total_included"
                    string="GST Inclusive"
                    help="When enabled, forces all taxes to be computed as price included for invoices with this partner"
                />
            </xpath>
        </field>
    </record>
</odoo>
