<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form_inherit_tax_total_included" model="ir.ui.view">
        <field name="name">account.move.form.inherit.tax.total.included</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="after">
                <div
                    class="alert alert-info"
                    role="alert"
                    invisible="not force_tax_total_included"
                >
                    <strong>GST Inclusive Invoice Lines</strong>
                </div>
            </xpath>

            <xpath expr="//field[@name='invoice_incoterm_id']" position="after">
                <field
                    name="force_tax_total_included"
                    readonly="state != 'draft'"
                    invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')"
                    help="GST Inclusive"
                />
            </xpath>
        </field>
    </record>
</odoo>
