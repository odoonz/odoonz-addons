<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.credit.control</field>
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="sale_financial_risk.res_config_settings_view_form"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='allow_overrisk_invoice_validation']/../.."
                position="inside"
            >
                <setting
                    id="enforce_limit_sale"
                    string="All customers must have limit"
                    help="Check customer has credit limit before confirming sale orders"
                >
                    <field name="enforce_limit_sale" />
                </setting>
                <setting
                    id="allowed_min_sale"
                    string="Allowed amount"
                    help="Minimum risk value before enforcing"
                >
                    <field name="allowed_min_sale" />
                </setting>
            </xpath>
        </field>
    </record>


</odoo>
